# ================================================================
# Truckin all Day (v2) — Environment Configuration Template
# ================================================================
# Copy this file to .env for local development: cp .env.example .env

# Site Metadata
VITE_SITE_URL=https://truckinallday.netlify.app
VITE_SITE_NAME="Truckin all Day"

# Merchandise & Store Configuration
# If linking to an external checkout provider (e.g. Bandcamp, Shopify, Printful):
VITE_STORE_ENABLED=true
VITE_STORE_CHECKOUT_URL=https://the-purple-vixon-shop.fourthwall.com
VITE_STORE_CURRENCY=USD

# Email Newsletter / Fan Club Configuration
# Form uses Netlify Forms by default. Optional custom webhook or newsletter API:
VITE_NEWSLETTER_ENDPOINT=

# Analytics / Monitoring (Optional)
VITE_ANALYTICS_ID=
